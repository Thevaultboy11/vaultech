rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Vault Tech Industries ──────────────────────────────────────────
    // The whole app is one small document: vaultech/{vaultKey}
    // No sign-in: the long random vault key is the password.
    // "get" (not "read") means nobody can list the collection to find keys.
    match /vaultech/{vault} {
      allow get, delete: if vault.size() >= 24;
      allow create, update: if vault.size() >= 24
        && request.resource.data.json is string
        && request.resource.data.json.size() < 1000000;
    }

    // If other apps in this project (e.g. Clocky Clone) need rules,
    // keep them here inside this same block.
  }
}
