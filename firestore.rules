rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Vault Tech Industries ──────────────────────────────────────────
    // One document per signed-in account: vaultech/{uid}
    // You can only read or write your own document.
    match /vaultech/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // If other apps in this project (e.g. Clocky Clone) need rules,
    // keep them here inside this same block.
  }
}
